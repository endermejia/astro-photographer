---
import '../styles/styles.css';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
	title?: string;
	bodyClass?: string;
}

const { title, bodyClass } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
const mainTitle = 'Nhoa Sánchez | Fotografía';
const pageTitle = title ? `${title} | ${mainTitle}` : mainTitle;

// SEO basics
const siteUrl = 'https://nhoasanchez.com';
const canonicalUrl = lang === 'es' ? `${siteUrl}/` : `${siteUrl}/en/`;

// Structured Data (JSON-LD)
const schema = {
	'@context': 'https://schema.org',
	'@type': ['LocalBusiness', 'ProfessionalService'],
	'@id': 'https://nhoasanchez.com#business',
	name: 'Nhoa Sánchez | Fotografía',
	url: 'https://nhoasanchez.com',
	image: 'https://nhoasanchez.com/assets/social.jpg',
	email: 'mailto:ainhoasanchezyepes@gmail.com',
	sameAs: ['https://www.instagram.com/nhoanoir', 'https://www.linkedin.com/in/ainhoasanchezyepes'],
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Castalla',
		addressRegion: 'Alicante',
		addressCountry: 'ES'
	},
	areaServed: [
		{ '@type': 'City', name: 'Castalla' },
		{ '@type': 'City', name: 'Tibi' },
		{ '@type': 'City', name: 'Ibi' },
		{ '@type': 'City', name: 'Onil' },
		{ '@type': 'City', name: 'Alcoy' }
	],
	availableLanguage: ['es', 'en'],
	priceRange: '€€'
};
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="author" content="Nhoa Sánchez" />
		<meta name="keywords" content={t('meta.keywords')} />
		<meta name="description" content={t('meta.description')} />

		<meta name="copyright" content={`© ${currentYear} Nhoa Sánchez | Fotografía`} />

		<meta name="robots" content="index, follow" />

		<!-- Canonical & hreflang -->
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" href="https://nhoasanchez.com/" hreflang="es" />
		<link rel="alternate" href="https://nhoasanchez.com/en/" hreflang="en" />
		<link rel="alternate" href="https://nhoasanchez.com/" hreflang="x-default" />

		<!-- Icons -->
		<link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg" />
		<link rel="icon" type="image/png" href="/assets/icons/favicon.png" />
		<link rel="preload" as="image" href="/assets/img/hero/a-1920.jpg" fetchpriority="high" />

		<!--Open Graph-->
		<meta property="og:title" content={pageTitle} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:description" content={t('meta.description')} />
		<meta property="og:image" content="https://nhoasanchez.com/assets/social.jpg" />
		<meta property="og:image:width" content="1280" />
		<meta property="og:image:height" content="640" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={t('meta.description')} />
		<meta name="twitter:image" content="https://nhoasanchez.com/assets/social.jpg" />

		<!-- Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	</head>
	<body id="home" class={bodyClass}>
		<slot />
	</body>
</html>

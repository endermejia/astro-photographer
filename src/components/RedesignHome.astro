<script>
	const track = document.querySelector('.horizontal-track');
	const work = document.querySelector('.work');
	let frame = 0;
	const moveTrack = () => {
		if (!track || !work) return;
		const top = work.offsetTop;
		const range = Math.max(1, work.offsetHeight - window.innerHeight);
		const progress = Math.min(1, Math.max(0, (window.scrollY - top) / range));
		const distance = Math.max(0, track.scrollWidth - window.innerWidth + window.innerWidth * 0.1);
		track.style.transform = `translate3d(${-progress * distance}px, 0, 0)`;
	};
	const scheduleTrack = () => {
		if (frame) return;
		frame = window.requestAnimationFrame(() => {
			frame = 0;
			moveTrack();
		});
	};
	window.addEventListener('scroll', scheduleTrack, { passive: true });
	window.addEventListener('resize', scheduleTrack);
	window.addEventListener('load', moveTrack);
	if (document.fonts) document.fonts.ready.then(moveTrack);
</script>
